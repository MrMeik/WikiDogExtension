{
  "manifest_version": 3,
  "name": "WikiDog - DogOnline Action Logger",
  "version": "0.2.0",
  "description": "Unofficial extension that gathers information about various DogOnline interactions",
  "permissions": ["storage"],
  "host_permissions": ["https://wikidogbackend.onrender.com/*"],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "32": "wikidog_icon-32.png",
    "64": "wikidog_icon-64.png",
    "128": "wikidog_icon-128.png"
  },
  "background": {
    "service_worker": "src/uploading/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://dogonline.net/*"],
      "js": ["src/page/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://dogonline.net/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "dogonline-tracker@wikidog.mrmeik",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  }
}
