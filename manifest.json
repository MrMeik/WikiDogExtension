{
  "manifest_version": 3,
  "name": "DogOnline Tracker",
  "version": "0.1.0",
  "description": "Records what happens in Dog Online. Fishing is logged now; tower and gachapon plug into the same trackers.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://dogonline.net/*"],
      "js": ["src/page/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://dogonline.net/*"],
      "js": [
        "src/core/namespace.js",
        "src/core/helpers.js",
        "src/core/dispatcher.js",
        "src/core/sync.js",
        "src/context/weather.js",
        "src/trackers/fishing.js",
        "src/trackers/tower.js",
        "src/trackers/gachapon.js",
        "src/core/bridge.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "dogonline-tracker@example.invalid",
      "strict_min_version": "128.0"
    }
  }
}
