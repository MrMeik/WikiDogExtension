{
  "manifest_version": 3,
  "name": "WikiDog - DogOnline Action Logger",
  "version": "0.1.1",
  "description": "Unofficial extension that gathers information about DogOnline interactions with fishing, gachapon, mob kills and opening chests",
  "permissions": ["storage"],
  "host_permissions": ["https://wikidogbackend.onrender.com/*"],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "128": "wikidog_icon.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://dogonline.net/*"],
      "js": ["src/page/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://dogonline.net/*"],
      "js": [
        "src/core/namespace.js",
        "src/core/helpers.js",
        "src/core/dispatcher.js",
        "src/core/sync.js",
        "src/context/weather.js",
        "src/trackers/fishing.js",
        "src/trackers/tower.js",
        "src/trackers/gachapon.js",
        "src/core/bridge.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "dogonline-tracker@wikidog.mrmeik",
      "strict_min_version": "128.0"
    }
  }
}
